# Data (never versioned). data/* rather than data/ so the .gitkeep that
# keeps the directory in the repo can be re-included.
data/*
!data/.gitkeep

# Python
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/
build/
dist/

# Tooling
.pytest_cache/
.ruff_cache/
.coverage
coverage.xml
htmlcov/
.ipynb_checkpoints/

# Environment
.env

# Trained models and artefacts. Anchored to the root: without the leading
# slash, 'models/' also shadowed src/parking/models/.
/models/
/artifacts/
*.pkl
*.joblib
*.txt.model

# Editors / OS
.vscode/
.idea/
.DS_Store
Thumbs.db
