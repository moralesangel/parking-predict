# Copy to .env and adjust. Nothing here is secret:
# the City of Melbourne Open Data API is public.

# --- Source API ---
# Base host of the open data portal. The concrete endpoint path is set in
# code, after verifying the real API schema.
PARKING_API_BASE_URL=https://data.melbourne.vic.gov.au
# Identifier of the real-time sensor dataset
PARKING_REALTIME_DATASET=on-street-parking-bay-sensors
# API token (optional; the API is public but a token raises the quota)
# PARKING_API_KEY=

# --- Polling ---
# Seconds between snapshots. 120 is the feed's native cadence: it publishes a
# new batch every 2 minutes exactly (measured). Minimum accepted: 60.
PARKING_POLL_INTERVAL_SECONDS=120
PARKING_REQUEST_TIMEOUT_SECONDS=30
PARKING_MAX_RETRIES=4

# --- Data quality ---
# Hours without a state change after which a bay that IS still reporting is
# considered stuck. 24 h comes from the valley of the real distribution, which
# is bimodal (see docs/data_quality.md).
PARKING_STUCK_AFTER_HOURS=24
# Seconds between two consecutive batches after which a gap in the series is
# declared. 360 = 3 feed cycles, to tolerate normal delays.
PARKING_GAP_AFTER_SECONDS=360

# --- Storage ---
# Data root; raw/ and processed/ are derived from it
PARKING_DATA_DIR=data
# Static frontend served by the API. In Docker it is set to /app/web.
PARKING_WEB_DIR=web
