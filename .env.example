# Copiar a .env y ajustar. Ningún valor aquí es secreto:
# la API de City of Melbourne Open Data es pública.

# --- API de origen ---
# Host base del portal de datos abiertos. La ruta concreta del endpoint
# se fija en la Fase 1, tras verificar el esquema real de la API.
PARKING_API_BASE_URL=https://data.melbourne.vic.gov.au
# Identificador del dataset de sensores en tiempo real
PARKING_REALTIME_DATASET=on-street-parking-bay-sensors
# Token de API (opcional; la API es pública pero el token eleva la cuota)
# PARKING_API_KEY=

# --- Sondeo ---
# Intervalo entre snapshots, en segundos. 120 = cadencia nativa del feed,
# que publica un lote nuevo cada 2 min exactos (medido). Minimo admitido: 60.
PARKING_POLL_INTERVAL_SECONDS=120
PARKING_REQUEST_TIMEOUT_SECONDS=30
PARKING_MAX_RETRIES=4

# --- Calidad de datos ---
# Horas sin cambiar de estado a partir de las cuales una plaza que SI reporta
# se considera atascada. 24 h sale del valle de la distribucion real, que es
# bimodal (ver docs/data_quality.md).
PARKING_STUCK_AFTER_HOURS=24
# Segundos entre dos lotes consecutivos a partir de los cuales se declara un
# hueco en la serie. 360 = 3 ciclos del feed, para tolerar retrasos normales.
PARKING_GAP_AFTER_SECONDS=360

# --- Almacenamiento ---
# Raíz de datos; raw/ y processed/ se derivan de ella
PARKING_DATA_DIR=data
